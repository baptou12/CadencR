{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@cadence/service#dev": {
      "cache": false,
      "persistent": true
    },
    "@cadence/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "build:release": {
      "dependsOn": ["^build:release"],
      "outputs": []
    }
  }
}
