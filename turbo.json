{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "package": {
      "outputs": ["out/**"],
      "cache": false
    },
    "make": {
      "outputs": ["out/**"],
      "cache": false
    }
  }
}
