{
  "name": "@cadence/electron",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop app providing a UI for Claude Code",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": ".vite/build/main.js",
  "config": {
    "forge": "./forge.config.ts"
  },
  "scripts": {
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "test": "vitest run",
    "test:main": "vitest run --project main",
    "test:renderer": "vitest run --project renderer",
    "test:watch": "vitest",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "knip": "knip",
    "circular": "madge --circular --extensions ts,tsx src/",
    "generate:api": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.39",
    "@effect/platform": "^0.94.5",
    "@git-diff-view/lowlight": "^0.0.39",
    "@git-diff-view/react": "^0.0.39",
    "@git-diff-view/shiki": "^0.0.39",
    "@tanstack/react-query": "^4.43.0",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/router-vite-plugin": "^1.159.5",
    "@trpc/client": "^10.45.4",
    "@trpc/react-query": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "diff": "^8.0.3",
    "effect": "^3.19.19",
    "electron-squirrel-startup": "^1.0.1",
    "electron-trpc": "^0.7.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.563.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-cli": "^1.159.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "electron": "^33.2.0",
    "jsdom": "^28.1.0",
    "knip": "^5.85.0",
    "madge": "^8.0.0",
    "orval": "^8.5.3",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "productName": "Cadence"
}
