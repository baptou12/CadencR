---
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { FAQ_ITEMS } from "@/lib/faq";
---
<section id="faq" class="rule relative scroll-mt-16 py-16 sm:py-20">
  <Wrap maxWidth="narrow">
    <div class="reveal mb-9 max-w-[560px]">
      <Eyebrow>FAQ</Eyebrow>
      <h2 class="type-h2 mt-3.5 text-[clamp(26px,3.4vw,36px)] [text-wrap:balance]">
        What CadencR is, in plain terms.
      </h2>
    </div>

    <dl class="reveal reveal-late faq-list m-0">
      {
        FAQ_ITEMS.map((item, i) => (
          <div class="faq-item">
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center gap-4 py-4 [&::-webkit-details-marker]:hidden">
                <span class="w-8 shrink-0 font-mono text-[11px] text-muted-foreground" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <dt class="flex-1 text-[15px] font-medium tracking-[-0.005em] text-foreground">
                  {item.q}
                </dt>
                <span class="faq-toggle inline-flex h-7 w-7 shrink-0 items-center justify-center border border-border text-muted-foreground transition-all duration-200 group-open:rotate-45 group-open:border-primary/60 group-open:text-primary">
                  <svg
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                </span>
              </summary>
              <dd class="m-0 max-w-[62ch] pb-5 pl-12 text-[14px] leading-[1.65] text-muted-foreground">
                {item.a}
              </dd>
            </details>
          </div>
        ))
      }
    </dl>
  </Wrap>
</section>

<style>
  .faq-item {
    border-top: 1px solid color-mix(in oklch, var(--color-border) 62%, transparent);
  }
  .faq-item:last-child {
    border-bottom: 1px solid color-mix(in oklch, var(--color-border) 62%, transparent);
  }
  .faq-item:has(details[open]) dt {
    color: var(--color-foreground);
  }
</style>
