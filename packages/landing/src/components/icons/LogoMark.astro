---
// Index Dots — the official CadencR mark (DESIGN.md "Logo").
// Twelve ink dots on a ring around a solid iris core, on the 48 grid.
// Dots follow the surrounding text color; the core takes the theme primary.
import { ringDots } from "@/lib/logo-dots.mjs";
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
const dots = ringDots();
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  aria-hidden="true"
  fill="none"
>
  {dots.map((d) => <circle cx={d.cx} cy={d.cy} r="1.9" fill="currentColor" />)}
  <circle cx="24" cy="24" r="5.5" fill="var(--color-primary)" />
</svg>
