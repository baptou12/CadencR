---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---
<figure class="my-6">
  <Image
    src={src}
    alt={alt}
    widths={[720, 1200, 1600]}
    sizes="(min-width: 768px) 720px, 100vw"
    format="webp"
    quality={95}
    loading="lazy"
    decoding="async"
    class="block h-auto w-full rounded-xl border border-border shadow-md"
  />
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-muted-foreground">{caption}</figcaption>
  )}
</figure>
