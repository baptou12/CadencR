---
import { DOC_SECTIONS, getDocHref } from "@/lib/docs";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(slug: string): boolean {
  return slug.length === 0 ? currentPath.endsWith("/docs/") : currentPath.includes(`/docs/${slug}`);
}
---
<aside class="hidden xl:block">
  <div class="sticky top-[76px] rounded-2xl border border-border/70 bg-sidebar/35 p-4">
    <nav aria-label="Docs navigation" class="space-y-5 text-sm">
      {
        DOC_SECTIONS.map((section) => (
          <section>
            <h2 class="mb-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">
              {section.title}
            </h2>
            <ul class="space-y-1">
              {section.pages.map((page) => {
                const active = isActive(page.slug);
                return (
                  <li>
                    <a
                      href={getDocHref(page.slug)}
                      aria-current={active ? "page" : undefined}
                      class:list={[
                        "block rounded-lg px-3 py-2 transition-colors",
                        active
                          ? "bg-primary/14 text-foreground"
                          : "text-muted-foreground hover:bg-accent/55 hover:text-foreground",
                      ]}
                    >
                      {page.navLabel}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </nav>
  </div>
</aside>

