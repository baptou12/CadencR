---
import { Image } from "astro:assets";
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import CodeIcon from "@/components/icons/CodeIcon.astro";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import heroImage from "@/assets/hero.png";
---
<section class="relative py-16 pb-14">
  <div class="hero-orbits pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true"></div>
  <Wrap>
    <div
      class="relative z-10 grid items-center gap-12 md:gap-14 [grid-template-columns:minmax(0,0.82fr)_minmax(0,1.18fr)]"
    >
      <div class="relative z-10 max-w-[520px]">
        <Eyebrow>Desktop IDE · macOS · Linux · Apache-2.0</Eyebrow>
        <h1
          class="mt-3.5 mb-3.5 text-[clamp(28px,3vw,38px)] font-semibold leading-[1.12] tracking-[-0.018em] [text-wrap:balance]"
        >
          The IDE for the era of agents.<br />
          <span class="text-muted-foreground">
            One workspace — Claude Code, OpenCode, and Codex.
          </span>
        </h1>
        <p class="text-sm leading-[1.6] text-muted-foreground [text-wrap:pretty] [&_.em]:text-foreground">
          Cadence is the surface you read, steer and ship from.
          <span class="em">Your harness stays the same</span>
          — the stream becomes readable, sessions can branch into their own worktree or terminal, and git stays where you can see it.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <Button href="https://github.com/rle-mino/cadence/releases/latest" size="lg">
            <DownloadIcon />
            Download for Mac
          </Button>
          <Button href="https://github.com/rle-mino/cadence" variant="outline" size="lg">
            <CodeIcon />
            Source on GitHub
          </Button>
        </div>
      </div>

      <div class="relative z-10 min-w-0">
        <Image
          src={heroImage}
          alt="Cadence desktop app showing a session with code, streaming agent output, and git worktree"
          loading="eager"
          decoding="async"
          widths={[800, 1200, 1600, 2048]}
          sizes="(min-width: 1280px) 1024px, (min-width: 768px) 75vw, 100vw"
          format="webp"
          class="block h-auto w-[calc(100%+16rem)] max-w-none xl:w-[calc(100%+24rem)]"
        />
      </div>
    </div>
  </Wrap>
</section>
