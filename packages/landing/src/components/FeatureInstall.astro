---
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import GithubIcon from "@/components/icons/GithubIcon.astro";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Lede from "@/components/ui/Lede.astro";
import Button from "@/components/ui/Button.astro";

const tabs = ["macOS", "Linux", "Build from source"] as const;
interface Cmd {
  activeTab: (typeof tabs)[number];
  lines: string[];
}
const cards: Cmd[] = [
  { activeTab: "macOS", lines: ["brew install --cask cadence-ide"] },
  { activeTab: "Linux", lines: ["curl -fsSL cadence.dev/install.sh | sh"] },
  {
    activeTab: "Build from source",
    lines: [
      "git clone https://github.com/cadence-ide/cadence",
      "cd cadence && pnpm i && pnpm tauri build",
    ],
  },
];
---
<section id="install" class="relative py-20 border-t border-border/55">
  <Wrap>
    <div
      class="grid grid-cols-1 gap-8 md:items-start md:gap-12 md:[grid-template-columns:minmax(0,0.95fr)_minmax(0,1.05fr)]"
    >
      <div>
        <Eyebrow>06 · Install</Eyebrow>
        <SectionHeading>Local, fast, open.</SectionHeading>
        <Lede>
          Cadence is a Tauri binary — ~24 MB, runs offline, no background services. Source under MIT on GitHub.
        </Lede>
        <div class="mt-4.5 flex flex-wrap gap-2">
          <Button href="https://github.com/cadence-ide/cadence/releases/latest" size="lg">
            <DownloadIcon />
            Download v0.9.2
          </Button>
          <Button href="https://github.com/cadence-ide/cadence" variant="outline" size="lg">
            <GithubIcon />
            Source
          </Button>
        </div>
        <div class="mt-4.5 flex flex-col gap-[3px] font-mono text-[11px] text-muted-foreground">
          <div>macOS 13+ · Apple Silicon and Intel</div>
          <div>Linux x86_64 · AppImage · deb · rpm</div>
          <div>
            <span class="text-drac-orange">Windows</span> · tracked in
            <a class="text-drac-purple hover:underline" href="https://github.com/cadence-ide/cadence/issues/47">#47</a>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-2.5">
        {cards.map((card) => (
          <div class="overflow-hidden rounded-lg border border-border bg-muted/25">
            <div class="flex gap-0.5 border-b border-border px-2 pt-1">
              {tabs.map((label) => (
                <div
                  class:list={[
                    "-mb-px border-b-2 px-2.5 py-1.5 font-mono text-[11px]",
                    label === card.activeTab
                      ? "border-primary text-foreground"
                      : "border-transparent text-muted-foreground",
                  ]}
                >
                  {label}
                </div>
              ))}
            </div>
            <div class="flex flex-col gap-1.5 p-3.5 font-mono text-xs">
              {card.lines.map((line) => (
                <div class="flex items-center gap-2.5">
                  <span class="text-drac-green">$</span>
                  <span class="flex-1 overflow-hidden text-ellipsis whitespace-nowrap text-drac-fg">
                    {line}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Wrap>
</section>
