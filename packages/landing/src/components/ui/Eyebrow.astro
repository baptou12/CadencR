---
/**
 * Figure label — the sheet's kicker. Mono, uppercase, ≤11px: the only
 * all-caps tier in the system. With `index`, reads as "Fig. 03 · Git".
 */
interface Props {
  /** Figure number ("01", "02", …) rendered in the accent color. */
  index?: string;
}
const { index } = Astro.props;
---
<span class="fig-label">
  {index && (
    <>
      <span class="fig-no">Fig. {index}</span>
      <span aria-hidden="true">·</span>
    </>
  )}
  <slot />
</span>
