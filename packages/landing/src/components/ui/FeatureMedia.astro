---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** When true, image extends to the left (matches FeatureSection `reverse`). */
  reverse?: boolean;
  /** Shows a 1px border around the image — useful when the screenshot has no chrome. */
  bordered?: boolean;
}

const { src, alt, reverse = false, bordered = false } = Astro.props;

const bleed = reverse
  ? "md:w-[calc(100%+4rem)] md:-ml-16 xl:w-[calc(100%+7rem)] xl:-ml-28"
  : "md:w-[calc(100%+8rem)] xl:w-[calc(100%+14rem)]";
const border = bordered ? "border border-border" : "";
---
<Image
  src={src}
  alt={alt}
  widths={[900, 1200, 1800]}
  sizes="(min-width: 1024px) 560px, 100vw"
  format="webp"
  loading="lazy"
  decoding="async"
  class:list={["block h-auto w-full max-w-none rounded-xl", bleed, border]}
/>
