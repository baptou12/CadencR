---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A feature section's screenshot: the full app-window capture presented
 * frameless — the PNG carries its own window chrome and transparent
 * margins, so it gets a contour drop shadow and a faint neutral
 * monitor-light. The capture itself is the only color.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** When true, image extends to the left (matches FeatureSection `reverse`). */
  reverse?: boolean;
  /** Extend beyond the column on md+ screens (disable inside cards). */
  bleed?: boolean;
  /** Small mono caption under the media. */
  caption?: string;
  /**
   * Height classes (e.g. "h-[300px] xl:h-[380px]") for a fixed media area:
   * the window centers inside via object-contain. Use in card grids so
   * differently sized captures still align their text blocks.
   */
  height?: string;
}

const { src, alt, reverse = false, bleed = true, caption, height } = Astro.props;

const bleedClass = !bleed
  ? ""
  : reverse
    ? "md:w-[calc(100%+4rem)] md:-ml-16 xl:w-[calc(100%+7rem)] xl:-ml-28"
    : "md:w-[calc(100%+8rem)] xl:w-[calc(100%+14rem)]";
---
<figure class:list={["relative m-0", bleedClass]}>
  <div
    class="monitor-light pointer-events-none absolute inset-x-8 top-10 -bottom-4 -z-10"
    aria-hidden="true"
  >
  </div>
  <div class:list={[height]}>
    <Image
      src={src}
      alt={alt}
      widths={[900, 1200, 1800, 2400]}
      sizes="(min-width: 768px) 850px, 100vw"
      format="webp"
      quality={95}
      loading="lazy"
      decoding="async"
      class:list={[
        "feature-media-img block max-w-none",
        height ? "h-full w-full object-contain" : "h-auto w-full",
      ]}
    />
  </div>
  {/* Reverse bleed pulls the figure off the viewport edge — push the
      caption back so its text stays inside the column. */}
  {caption && (
    <figcaption class:list={["fig-caption", bleed && reverse && "md:ml-16 xl:ml-28"]}>
      {caption}
    </figcaption>
  )}
</figure>
