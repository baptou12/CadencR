---
/**
 * Single-key chip used in the docs.
 *
 * Mirrors the desktop app's `KbdShortcut` "modal" variant
 * (packages/desktop/src/components/KbdShortcut.tsx) so a key in the
 * docs looks identical to the same key inside the in-app shortcuts
 * modal (⌘/).
 */
---

<kbd class="doc-kbd">
  <slot />
</kbd>
