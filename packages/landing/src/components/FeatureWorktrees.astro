---
import FeatureSection from "@/components/FeatureSection.astro";
import Lede from "@/components/ui/Lede.astro";
import Kbd from "@/components/ui/Kbd.astro";
---
<FeatureSection
  id="worktrees"
  eyebrow="02 · Worktrees"
  heading="One feature — four agents in parallel."
  reverse
  placeholder={{
    label: "Worktrees — branches & sessions",
    hint: "screenshot pending",
    ratio: "16/10",
    caption: "4 worktrees · parallel agents",
  }}
>
  <Fragment slot="lede">
    <Lede>
      Every session gets its own git worktree, so each agent works on
      <span class="em">its own branch in its own checkout</span>.
      Run Claude Code and OpenCode on the same ticket at once, compare their diffs, keep the one you like.
    </Lede>
    <Lede class="mt-2.5">
      When you're ready, merge locally. Cadence never pushes on your behalf.
    </Lede>
  </Fragment>
  <Fragment slot="bullets">
    <li><strong>Auto worktree</strong> — new session, new branch, new working copy.</li>
    <li><strong>Parallel agents</strong> — let them race on the same ticket.</li>
    <li>
      <strong>Session switcher</strong> — <Kbd>⌘</Kbd><Kbd>1</Kbd> through <Kbd>⌘</Kbd><Kbd>9</Kbd>.
    </li>
    <li><strong>Clean teardown</strong> — archive a session, the worktree folds away.</li>
  </Fragment>
</FeatureSection>
