---
import Placeholder from "@/components/Placeholder.astro";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import BulletList from "@/components/ui/BulletList.astro";
import TwoUp from "@/components/ui/TwoUp.astro";

interface PlaceholderProps {
  label: string;
  hint?: string;
  ratio?: string;
  variant?: "window" | "flat";
  caption?: string;
}

/** Dracula accent driving the section's eyebrow, divider, and media glow. */
type Accent = "purple" | "cyan" | "green" | "orange" | "pink" | "yellow";

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  /** Section number ("01", "02", …) shown before the eyebrow label. */
  index?: string;
  reverse?: boolean;
  accent?: Accent;
  placeholder?: PlaceholderProps;
}
const { id, eyebrow, heading, index, reverse = false, accent = "purple", placeholder } = Astro.props;
---
<section
  id={id}
  class="relative overflow-hidden py-24"
  style={`--sec-accent: var(--color-drac-${accent})`}
>
  <div class="sec-divider" aria-hidden="true"></div>
  <div
    class:list={[
      "sec-glow pointer-events-none absolute -z-10",
      reverse ? "sec-glow-left" : "sec-glow-right",
    ]}
    aria-hidden="true"
  >
  </div>
  <Wrap>
    <TwoUp reverse={reverse}>
      {reverse && (
        <div class="reveal reveal-late">
          <slot name="media">{placeholder && <Placeholder {...placeholder} />}</slot>
        </div>
      )}
      <div class="reveal">
        <Eyebrow index={index}>{eyebrow}</Eyebrow>
        <SectionHeading>{heading}</SectionHeading>
        <slot name="lede" />
        <BulletList>
          <slot name="bullets" />
        </BulletList>
      </div>
      {!reverse && (
        <div class="reveal reveal-late">
          <slot name="media">{placeholder && <Placeholder {...placeholder} />}</slot>
        </div>
      )}
    </TwoUp>
  </Wrap>
</section>
