---
import Placeholder from "@/components/Placeholder.astro";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import BulletList from "@/components/ui/BulletList.astro";
import TwoUp from "@/components/ui/TwoUp.astro";

interface PlaceholderProps {
  label: string;
  hint?: string;
  ratio?: string;
  variant?: "window" | "flat";
  caption?: string;
}

interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  /** Figure number ("01", "02", …) shown in the fig-label. */
  index?: string;
  reverse?: boolean;
  placeholder?: PlaceholderProps;
}
const { id, eyebrow, heading, index, reverse = false, placeholder } = Astro.props;
---
<section id={id} class="rule relative scroll-mt-16 py-16 sm:py-20">
  <Wrap>
    <TwoUp reverse={reverse}>
      {reverse && (
        <div class="reveal reveal-late">
          <slot name="media">{placeholder && <Placeholder {...placeholder} />}</slot>
        </div>
      )}
      <div class="reveal">
        <Eyebrow index={index}>{eyebrow}</Eyebrow>
        <SectionHeading>{heading}</SectionHeading>
        <slot name="lede" />
        <BulletList>
          <slot name="bullets" />
        </BulletList>
      </div>
      {!reverse && (
        <div class="reveal reveal-late">
          <slot name="media">{placeholder && <Placeholder {...placeholder} />}</slot>
        </div>
      )}
    </TwoUp>
  </Wrap>
</section>
