---
import LogoMark from "@/components/icons/LogoMark.astro";
import GithubIcon from "@/components/icons/GithubIcon.astro";
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import Button from "@/components/ui/Button.astro";
import { DISPLAY_VERSION } from "@/lib/app-version";

const base = import.meta.env.BASE_URL;
// Order mirrors the page's scroll order so the nav is a table of contents.
const navLinks = [
  { href: `${base}#compat`, label: "Compatibility" },
  { href: `${base}#features`, label: "Features" },
  { href: `${base}news/`, label: "News" },
  { href: `${base}docs/`, label: "Docs" },
];
---
<header class="sticky top-0 z-50 border-b border-border/50 bg-background/90 shadow-[0_1px_12px_rgb(0_0_0/0.25)] backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1180px] items-center gap-3 px-4 sm:gap-[22px] sm:px-6">
    <a href={base} class="inline-flex items-center gap-2.5">
      <LogoMark size={52} />
      <span class="font-brand text-[24px] font-extrabold uppercase leading-none tracking-[0.05em]">CadencR</span>
      <span
        aria-hidden="true"
        class="hidden rounded-full bg-accent px-2 py-0.5 font-mono text-[10px] text-muted-foreground sm:inline-block"
      >
        {DISPLAY_VERSION}
      </span>
    </a>
    <nav
      aria-label="Primary"
      class="ml-3.5 hidden gap-[18px] text-[13px] text-muted-foreground md:flex [&_a:hover]:text-foreground"
    >
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <span class="flex-1"></span>
    <a
      href="https://github.com/merkr-software/cadencr"
      aria-label="merkr-software/cadencr on GitHub"
      class="hidden h-8 items-center gap-1.5 rounded-md px-[9px] font-mono text-xs text-muted-foreground hover:bg-accent hover:text-foreground sm:inline-flex [&_svg]:h-3 [&_svg]:w-3 [&_svg]:stroke-[2]"
    >
      <GithubIcon />
      merkr-software/cadencr
    </a>
    <Button href={`${base}download/`} variant="outline" size="sm" class="h-9 px-3">
      <DownloadIcon />
      Download
    </Button>
    <details class="relative md:hidden" data-mobile-menu>
      <summary
        aria-label="Open menu"
        aria-expanded="false"
        class="inline-flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground [&::-webkit-details-marker]:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute right-0 top-full mt-2 flex w-52 flex-col gap-1 rounded-xl border border-border/60 bg-background p-2 text-sm shadow-md"
      >
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded px-3 py-2.5 text-muted-foreground hover:bg-accent hover:text-foreground"
          >
            {link.label}
          </a>
        ))}
        <a
          href="https://github.com/merkr-software/cadencr"
          class="rounded px-3 py-2.5 text-muted-foreground hover:bg-accent hover:text-foreground"
        >
          GitHub
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Mobile menu: reflect open state on the summary (aria-expanded + label),
  // close when a link is clicked or on outside click.
  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  if (menu) {
    const summary = menu.querySelector("summary");
    const sync = () => {
      summary?.setAttribute("aria-expanded", String(menu.open));
      summary?.setAttribute("aria-label", menu.open ? "Close menu" : "Open menu");
    };
    menu.addEventListener("toggle", sync);
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => menu.removeAttribute("open"))
    );
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.removeAttribute("open");
    });
  }
</script>
