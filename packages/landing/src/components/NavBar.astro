---
import LogoMark from "@/components/icons/LogoMark.astro";
import GithubIcon from "@/components/icons/GithubIcon.astro";
import StarIcon from "@/components/icons/StarIcon.astro";
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import Button from "@/components/ui/Button.astro";

const base = import.meta.env.BASE_URL;
---
<header class="sticky top-0 z-50 border-b border-border/55 bg-background/90 backdrop-blur-md backdrop-saturate-[1.4]">
  <div class="mx-auto flex h-[52px] max-w-[1160px] items-center gap-[22px] px-6">
    <a href={base} aria-label="Cadence home" class="inline-flex items-center gap-2.5">
      <LogoMark size={36} />
      <span class="text-sm font-bold uppercase tracking-[0.14em]">Cadence</span>
      <span class="font-mono text-[10px] text-muted-foreground rounded border border-border px-[5px] py-px">
        v0.1.0
      </span>
    </a>
    <nav
      aria-label="Primary"
      class="ml-3.5 hidden gap-[18px] text-[12.5px] text-muted-foreground md:flex [&_a:hover]:text-foreground"
    >
      <a href={`${base}#readability`}>Features</a>
      <a href={`${base}#compat`}>Compatibility</a>
      <a href={`${base}roadmap/`}>Roadmap</a>
      <a href={`${base}news/`}>News</a>
      <a href={`${base}docs/`}>Docs</a>
    </nav>
    <span class="flex-1"></span>
    <div class="flex items-center gap-2">
      <a
        href="https://github.com/rle-mino/cadence"
        aria-label="Star on GitHub"
        class="inline-flex h-7 items-stretch overflow-hidden rounded-md border border-border font-mono text-xs [&>span]:inline-flex [&>span]:items-center [&>span]:gap-1.5 [&>span]:px-[9px] [&_svg]:h-3 [&_svg]:w-3 [&_svg]:stroke-[2]"
      >
        <span class="text-muted-foreground hover:bg-accent hover:text-foreground">
          <GithubIcon />
          rle-mino/cadence
        </span>
        <span class="border-l border-border bg-muted/35 font-medium text-foreground">
          <StarIcon />
          <span data-github-stars>0</span>
        </span>
      </a>
      <Button href="https://github.com/rle-mino/cadence/releases/latest" size="sm">
        <DownloadIcon />
        Download
      </Button>
    </div>
  </div>
</header>

<script>
  const REPO = "rle-mino/cadence";
  const CACHE_KEY = `gh-stars:${REPO}`;
  const TTL_MS = 10 * 60 * 1000;

  const format = (n: number): string =>
    n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);

  const paint = (count: number): void => {
    for (const el of document.querySelectorAll<HTMLElement>("[data-github-stars]")) {
      el.textContent = format(count);
    }
  };

  let fresh = false;
  try {
    const cached = localStorage.getItem(CACHE_KEY);
    if (cached) {
      const { count, ts } = JSON.parse(cached) as { count: number; ts: number };
      paint(count);
      fresh = Date.now() - ts < TTL_MS;
    }
  } catch {
    /* corrupt cache — overwritten on next successful fetch */
  }

  if (!fresh) {
    fetch(`https://api.github.com/repos/${REPO}`, {
      headers: { Accept: "application/vnd.github+json" },
    })
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then((data: { stargazers_count?: number }) => {
        const count = data.stargazers_count;
        if (typeof count !== "number") return;
        paint(count);
        localStorage.setItem(CACHE_KEY, JSON.stringify({ count, ts: Date.now() }));
      })
      .catch(() => {
        /* keep the default 0; stars are non-critical UI */
      });
  }
</script>
