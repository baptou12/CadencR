---
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import Wrap from "@/components/ui/Wrap.astro";
import Button from "@/components/ui/Button.astro";
const base = import.meta.env.BASE_URL;
---
<section class="rule relative py-20 sm:py-28">
  <Wrap>
    <div class="reveal mx-auto max-w-[760px] text-center">
      <p class="fig-label justify-center">
        <span class="fig-no">Ready</span>
        <span aria-hidden="true">·</span>
        <span>brew install or one download</span>
      </p>
      <h2 class="type-display mx-auto mt-5 max-w-[640px] text-[clamp(32px,5.2vw,54px)] [text-wrap:balance]">
        Ship at the <span class="text-primary">cadence</span> of your agents.
      </h2>
      <p class="mx-auto mt-5 max-w-[46ch] text-[15px] leading-[1.65] text-muted-foreground">
        Free, open source, runs on your machine. Bring your own Claude, OpenCode, or Codex
        keys, and go.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href={`${base}download/`} size="lg" class="h-11 gap-2.5 px-5 text-sm">
          <DownloadIcon />
          Download
        </Button>
        <Button href={`${base}docs/`} variant="outline" size="lg" class="h-11 px-5 text-sm">
          Read the docs
        </Button>
      </div>
    </div>
  </Wrap>
</section>
