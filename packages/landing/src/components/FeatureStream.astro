---
import { Image } from "astro:assets";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Lede from "@/components/ui/Lede.astro";
import CompareSlider from "@/components/ui/CompareSlider.astro";
import StreamTerminal from "@/components/StreamTerminal.astro";
import streamShot from "@/assets/side-by-side.png";

// The capture carries its own window chrome inside a transparent-margin
// PNG. The slider needs a full-bleed layer, so scale/offset the image to
// the exact window bounds (fully-opaque alpha bbox) — the whole UI stays
// visible and the frame border sits right on the window edge.
const box = { x: 112, y: 76, w: 2056, h: 2580 };
const pct = (n: number, d: number) => `${((n / d) * 100).toFixed(3)}%`;
const shotStyle = [
  "position: absolute",
  `top: ${pct(-box.y, box.h)}`,
  `left: ${pct(-box.x, box.w)}`,
  `width: ${pct(streamShot.width, box.w)}`,
  "max-width: none",
  "height: auto",
].join("; ");

const highlights = [
  {
    title: "Inline diffs",
    body: "Themed syntax, +/- gutters, not walls of unified patch.",
  },
  {
    title: "Tool-call pills",
    body: "Bash, Grep, Read, Edit, Thinking. Click to expand.",
  },
  {
    title: "Per-message model tag",
    body: "Never guess which agent said what.",
  },
  {
    title: "Context meter",
    body: "In the status bar, so you see the window filling.",
  },
];
---
<section id="stream" class="rule relative scroll-mt-16 py-16 sm:py-20">
  <Wrap>
    <div class="reveal mx-auto max-w-[640px] text-center">
      <Eyebrow index="03">Stream</Eyebrow>
      <SectionHeading>Your agent's output — finally readable.</SectionHeading>
      <Lede class="mx-auto mt-3">
        Raw terminal output buries every signal under
        <span class="em">bash, grep, cat, head</span>.
        CadencR reinterprets the stream as it arrives: same agent, same commands, orders of
        magnitude more legible.
      </Lede>
    </div>

    <figure class="reveal reveal-late relative mx-auto mt-12 max-w-[680px]">
      <div
        class="monitor-light pointer-events-none absolute inset-x-10 top-12 -bottom-6 -z-10"
        aria-hidden="true"
      >
      </div>
      <div class="reg-marks">
        <span class="reg-b"></span>
        <CompareSlider aspect={`${box.w}/${box.h}`} leftLabel="CadencR" rightLabel="Raw terminal">
          <Image
            slot="left"
            src={streamShot}
            alt="CadencR's rendering of the agent turn: collapsible thinking, tool-call pills, an inline diff, and a formatted summary with a table"
            widths={[800, 1200, 1600, 2280]}
            sizes="(min-width: 768px) 780px, 110vw"
            format="webp"
            quality={95}
            loading="lazy"
            decoding="async"
            style={shotStyle}
          />
          <StreamTerminal slot="right" />
        </CompareSlider>
      </div>
      <figcaption class="fig-caption justify-center">
        Drag — the same agent turn, twice
      </figcaption>
    </figure>

    <ul class="reveal reveal-late stream-specs mx-auto mt-10 grid max-w-[1080px] list-none p-0 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {highlights.map((item, i) => (
        <li class="px-4 py-4">
          <p class="flex items-baseline gap-2 text-[13.5px] font-semibold tracking-[-0.005em] text-foreground">
            <span class="font-mono text-[11px] font-medium text-primary" aria-hidden="true">{`0${i + 1}`}</span>
            {item.title}
          </p>
          <p class="mt-1 text-[13px] leading-[1.55] text-muted-foreground">{item.body}</p>
        </li>
      ))}
    </ul>
  </Wrap>
</section>

<style>
  /* Ruled 4-up strip: hairlines between cells, no card chrome. */
  .stream-specs {
    border-block: 1px solid color-mix(in oklch, var(--color-border) 62%, transparent);
  }
  @media (min-width: 640px) {
    .stream-specs li + li {
      border-left: 1px solid color-mix(in oklch, var(--color-border) 62%, transparent);
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .stream-specs li:nth-child(3) {
      border-left: none;
    }
    .stream-specs li:nth-child(n + 3) {
      border-top: 1px solid color-mix(in oklch, var(--color-border) 62%, transparent);
    }
  }
  @media (max-width: 639px) {
    .stream-specs li + li {
      border-top: 1px solid color-mix(in oklch, var(--color-border) 62%, transparent);
    }
  }
</style>
