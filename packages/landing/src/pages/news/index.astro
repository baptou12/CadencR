---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Lede from "@/components/ui/Lede.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { formatDate } from "@/lib/formatDate";

type NewsEntry = CollectionEntry<"news">;
const entries: NewsEntry[] = (await getCollection("news")).sort(
  (a: NewsEntry, b: NewsEntry) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="News — Cadencr" description="Release notes, articles and announcements for Cadencr.">
  <section class="py-16 pb-24">
    <Wrap>
      <div class="mb-8 max-w-[680px]">
        <Eyebrow>News</Eyebrow>
        <h1 class="mt-3 mb-3 text-[clamp(26px,3vw,34px)] font-semibold leading-[1.18] tracking-[-0.018em] [text-wrap:balance]">
          What we shipped, what we're thinking.
        </h1>
        <Lede>
          Release notes, deep dives and short announcements. Subscribe via the
          <a href={`${base}rss.xml`} class="text-drac-purple hover:underline">RSS feed</a>.
        </Lede>
      </div>

      {entries.length === 0 ? (
        <EmptyState lead="No posts yet.">
          {" "}The first article will land with v1.0 — the redesigned stream renderer and dynamic roadmap.
        </EmptyState>
      ) : (
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2">
          {entries.map((entry: NewsEntry) => (
            <a
              href={`${base}news/${entry.slug}/`}
              class="flex flex-col gap-2 rounded-lg border border-border bg-muted/20 p-5 transition-colors duration-150 hover:border-primary/40"
            >
              <span class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted-foreground">
                {formatDate(entry.data.date)}
              </span>
              <span class="text-[15.5px] font-semibold tracking-[-0.005em]">{entry.data.title}</span>
              <span class="text-[13px] leading-[1.5] text-muted-foreground">{entry.data.summary}</span>
            </a>
          ))}
        </div>
      )}
    </Wrap>
  </section>
</BaseLayout>
