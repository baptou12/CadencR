---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Lede from "@/components/ui/Lede.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { formatDate } from "@/lib/formatDate";

type RoadmapStatus = "planned" | "in-progress" | "done";
type RoadmapEntry = CollectionEntry<"roadmap">;

const entries: RoadmapEntry[] = await getCollection("roadmap");
const statuses: Array<{ key: RoadmapStatus; label: string; accent: string }> = [
  { key: "in-progress", label: "In progress", accent: "text-drac-yellow" },
  { key: "planned", label: "Planned", accent: "text-drac-cyan" },
  { key: "done", label: "Shipped", accent: "text-drac-green" },
];

const grouped: Record<RoadmapStatus, RoadmapEntry[]> = {
  "in-progress": [],
  planned: [],
  done: [],
};
for (const e of entries) {
  // Cast needed while the collection is empty: Astro resolves CollectionEntry
  // to `any` until the first entry exists. Safe to drop once content lands.
  grouped[e.data.status as RoadmapStatus].push(e);
}
for (const key of Object.keys(grouped) as RoadmapStatus[]) {
  grouped[key].sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return b.data.date.valueOf() - a.data.date.valueOf();
  });
}

---
<BaseLayout
  title="Roadmap — Cadence"
  description="Shipped, in progress and planned work on Cadence."
>
  <section class="py-16 pb-24">
    <Wrap>
      <div class="mb-8 max-w-[680px]">
        <Eyebrow>Roadmap</Eyebrow>
        <h1 class="mt-3 mb-3 text-[clamp(26px,3vw,34px)] font-semibold leading-[1.18] tracking-[-0.018em] [text-wrap:balance]">
          What's shipped, what's cooking, what's next.
        </h1>
        <Lede>
          Public, opinionated, and occasionally reordered. Item dates are the target month, not a contract.
        </Lede>
      </div>

      {entries.length === 0 ? (
        <EmptyState lead="Roadmap loading.">
          {" "}Milestones will appear here as they are formalized in git.
        </EmptyState>
      ) : (
        <div class="flex flex-col gap-8">
          {statuses.map(({ key, label, accent }) => (
            grouped[key].length > 0 && (
              <div class="flex flex-col gap-3.5">
                <h2
                  class={`timeline-head inline-flex items-center gap-2 font-mono text-[13px] uppercase tracking-[0.08em] ${accent}`}
                >
                  {label}
                </h2>
                <div class="flex flex-col gap-2.5 border-l border-dashed border-border pl-4">
                  {grouped[key].map((item) => (
                    <div class="flex flex-col gap-1 rounded-lg border border-border bg-muted/20 px-3.5 py-2.5">
                      <div class="flex gap-2.5 font-mono text-[10.5px] uppercase tracking-[0.06em] text-muted-foreground">
                        <span>{formatDate(item.data.date, { year: "numeric", month: "short" })}</span>
                        <span>·</span>
                        <span>{item.data.category}</span>
                      </div>
                      <div class="text-sm font-semibold">{item.data.title}</div>
                    </div>
                  ))}
                </div>
              </div>
            )
          ))}
        </div>
      )}
    </Wrap>
  </section>
</BaseLayout>
