---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Lede from "@/components/ui/Lede.astro";

interface RoadmapMilestone {
  title: string;
  description: string;
  phase: "past" | "current" | "future";
}

interface PastRoadmapMilestone extends RoadmapMilestone {
  dateLabel: string;
  datetime: string;
  phase: "past";
}

const pastMilestones: PastRoadmapMilestone[] = [
  {
    dateLabel: "Feb 2026",
    datetime: "2026-02",
    title: "First commits",
    description:
      "Cadencr began as an Electron Forge and Vite app, using tRPC over Electron IPC as a thin Claude Code wrapper around projects and features.",
    phase: "past",
  },
  {
    dateLabel: "Mar 2026",
    datetime: "2026-03",
    title: "Effect service layer",
    description:
      "The core tRPC routers and agent orchestration were refactored toward Effect.js services, typed errors, and clearer dependency boundaries.",
    phase: "past",
  },
  {
    dateLabel: "Mar 2026",
    datetime: "2026-03",
    title: "Rust backend + WebSocket",
    description:
      "Git, workspace, session, and terminal domains moved into the Rust service, with WebSockets becoming the live transport for agent state.",
    phase: "past",
  },
  {
    dateLabel: "Apr 2026",
    datetime: "2026-04",
    title: "IDE-first workspace",
    description:
      "The product shifted from a Claude Code UI toward an IDE surface: terminal panes, editor tabs, git diffs, file trees, and keyboard-driven workflows.",
    phase: "past",
  },
  {
    dateLabel: "Apr 2026",
    datetime: "2026-04",
    title: "OpenCode and Codex",
    description:
      "Provider-neutral adapters and Rust SDKs brought OpenCode and Codex beside Claude, turning Cadencr into a multi-agent control surface.",
    phase: "past",
  },
  {
    dateLabel: "May 2026",
    datetime: "2026-05",
    title: "Open-source hardening",
    description:
      "Packaging, documentation, licensing, and reliability work landed so the project could be shared publicly with confidence.",
    phase: "past",
  },
];

const currentMilestone: RoadmapMilestone = {
  title: "Stability & Performance",
  description:
    "Eliminating stream, reconnect, startup, and render jank until large local workspaces feel boringly reliable.",
  phase: "current",
};

const futureMilestones: RoadmapMilestone[] = [
  {
    title: "Editor improvements",
    description:
      "Make the read-side editor better for reviewing agent changes, navigating files, and understanding context.",
    phase: "future",
  },
  {
    title: "Git improvements",
    description:
      "Deepen branch, diff, review, merge, and recovery flows so agent work can be inspected and landed faster.",
    phase: "future",
  },
  {
    title: "Linux distribution",
    description:
      "Ship a maintained Linux build path with predictable packaging, updates, and sidecar behavior.",
    phase: "future",
  },
  {
    title: "Windows distribution",
    description:
      "Bring the desktop app, backend service, terminal handling, and installer flow to Windows users.",
    phase: "future",
  },
  {
    title: "Remote workspaces",
    description:
      "Support supervising agents against remote machines and repositories without losing the local IDE control model.",
    phase: "future",
  },
  {
    title: "Custom tabs",
    description:
      "Let teams add their own persistent workspace surfaces alongside Agent, Terminal, Git, and Editor.",
    phase: "future",
  },
];

---
<BaseLayout
  title="Roadmap — Cadencr"
  description="Shipped and planned milestones on the Cadencr roadmap."
>
  <section class="py-16 pb-24">
    <Wrap>
      <div class="mb-10 max-w-[720px]">
        <Eyebrow>Roadmap</Eyebrow>
        <h1 class="mt-3 mb-3 text-[clamp(28px,4vw,46px)] font-semibold leading-[1.1] tracking-[-0.03em] [text-wrap:balance]">
          The path from thin wrapper to agent IDE.
        </h1>
        <Lede>
          A timeline of what shipped, where the project is now, and the next surfaces Cadencr is growing into.
        </Lede>
      </div>

      <div class="rounded-2xl border border-border bg-sidebar/70 p-4 shadow-lg sm:p-5">
        <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-mono text-[11px] uppercase tracking-[0.11em] text-muted-foreground">
            Past &larr; present &rarr; future
          </p>
          <div class="flex items-center gap-2">
            <p class="mr-1 hidden font-mono text-[11px] text-muted-foreground sm:block">
              Opens at now.
            </p>
            <button
              type="button"
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-muted/20 font-mono text-[13px] text-muted-foreground transition-colors duration-150 hover:border-drac-purple hover:text-foreground focus:outline-none focus:ring-2 focus:ring-drac-purple/60 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-border disabled:hover:text-muted-foreground"
              aria-label="Scroll roadmap to previous milestones"
              data-roadmap-previous
            >
              &larr;
            </button>
            <button
              type="button"
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-muted/20 font-mono text-[13px] text-muted-foreground transition-colors duration-150 hover:border-drac-purple hover:text-foreground focus:outline-none focus:ring-2 focus:ring-drac-purple/60 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-border disabled:hover:text-muted-foreground"
              aria-label="Scroll roadmap to future milestones"
              data-roadmap-next
            >
              &rarr;
            </button>
          </div>
        </div>

        <div class="relative overflow-hidden rounded-xl border border-border/80 bg-background/70">
          <div
            class="overflow-x-auto scroll-smooth outline-none focus:ring-2 focus:ring-drac-purple/60"
            tabindex="0"
            role="region"
            aria-label="Cadencr roadmap timeline"
            data-roadmap-track
          >
            <div class="relative min-w-max px-6 pt-8 pb-6">
              <span
                class="absolute top-[55.5px] right-6 left-6 h-px bg-gradient-to-r from-drac-green/30 via-drac-purple to-drac-cyan/30"
                aria-hidden="true"
              ></span>

              <ol class="flex snap-x snap-mandatory gap-4">
                {pastMilestones.map((milestone) => (
                  <li class="relative flex w-[min(78vw,320px)] shrink-0 snap-center flex-col">
                    <span
                      class="relative z-10 ml-4 mt-3 h-[31px] w-[31px] rounded-full border border-drac-green bg-background shadow-[0_0_0_7px_color-mix(in_oklch,var(--color-background)_80%,transparent)]"
                      aria-hidden="true"
                    ></span>
                    <article class="mt-7 min-h-[218px] rounded-xl border border-border bg-muted/20 p-5 shadow-xs transition-colors duration-150 hover:border-drac-green/45">
                      <div class="mb-3 flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.08em] text-muted-foreground">
                        <time datetime={milestone.datetime}>{milestone.dateLabel}</time>
                        <span aria-hidden="true">·</span>
                        <span class="text-drac-green">Shipped</span>
                      </div>
                      <h2 class="mb-2 text-[17px] font-semibold leading-tight tracking-[-0.015em]">
                        {milestone.title}
                      </h2>
                      <p class="text-[13.5px] leading-6 text-muted-foreground">
                        {milestone.description}
                      </p>
                    </article>
                  </li>
                ))}

                <li
                  class="relative flex w-[min(78vw,320px)] shrink-0 snap-center flex-col"
                  aria-current="step"
                  data-roadmap-present
                >
                  <span
                    class="relative z-10 ml-4 mt-3 h-[31px] w-[31px] rounded-full border border-drac-purple bg-background shadow-[0_0_0_7px_color-mix(in_oklch,var(--color-drac-purple)_18%,transparent)]"
                    aria-hidden="true"
                  ></span>
                  <article class="mt-7 min-h-[218px] rounded-xl border border-drac-purple/60 bg-drac-purple/10 p-5 shadow-xs">
                    <div class="mb-3 flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.08em] text-muted-foreground">
                      <span>Now</span>
                      <span aria-hidden="true">·</span>
                      <span class="text-drac-purple">Current focus</span>
                    </div>
                    <h2 class="mb-2 text-[17px] font-semibold leading-tight tracking-[-0.015em]">
                      {currentMilestone.title}
                    </h2>
                    <p class="text-[13.5px] leading-6 text-muted-foreground">
                      {currentMilestone.description}
                    </p>
                  </article>
                </li>

                {futureMilestones.map((milestone) => (
                  <li class="relative flex w-[min(78vw,320px)] shrink-0 snap-center flex-col">
                    <span
                      class="relative z-10 ml-4 mt-3 h-[31px] w-[31px] rounded-full border border-drac-cyan bg-background shadow-[0_0_0_7px_color-mix(in_oklch,var(--color-background)_80%,transparent)]"
                      aria-hidden="true"
                    ></span>
                    <article class="mt-7 min-h-[218px] rounded-xl border border-border bg-muted/20 p-5 shadow-xs transition-colors duration-150 hover:border-drac-cyan/45">
                      <div class="mb-3 flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.08em] text-muted-foreground">
                        <span>Planned</span>
                        <span aria-hidden="true">·</span>
                        <span class="text-drac-cyan">Future</span>
                      </div>
                      <h2 class="mb-2 text-[17px] font-semibold leading-tight tracking-[-0.015em]">
                        {milestone.title}
                      </h2>
                      <p class="text-[13.5px] leading-6 text-muted-foreground">
                        {milestone.description}
                      </p>
                    </article>
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <div
            class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-background/95 to-transparent"
            aria-hidden="true"
          ></div>
          <div
            class="pointer-events-none absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-background/95 to-transparent"
            aria-hidden="true"
          ></div>
        </div>
      </div>
    </Wrap>
  </section>
</BaseLayout>

<script>
  const timeline = document.querySelector<HTMLElement>("[data-roadmap-track]");
  const present = document.querySelector<HTMLElement>("[data-roadmap-present]");
  const previous = document.querySelector<HTMLButtonElement>("[data-roadmap-previous]");
  const next = document.querySelector<HTMLButtonElement>("[data-roadmap-next]");

  const getStep = (): number => Math.min(360, timeline?.clientWidth ?? 320);

  const updateControls = (): void => {
    if (!timeline || !previous || !next) return;
    const maxScroll = timeline.scrollWidth - timeline.clientWidth;
    previous.disabled = timeline.scrollLeft <= 1;
    next.disabled = timeline.scrollLeft >= maxScroll - 1;
  };

  const move = (direction: -1 | 1): void => {
    timeline?.scrollBy({ left: direction * getStep(), behavior: "smooth" });
  };

  const centerPresent = (): void => {
    if (!timeline || !present) return;
    const target = present.offsetLeft + present.clientWidth / 2 - timeline.clientWidth / 2;
    timeline.scrollTo({ left: Math.max(0, target), behavior: "auto" });
    updateControls();
  };

  requestAnimationFrame(centerPresent);

  previous?.addEventListener("click", (): void => move(-1));
  next?.addEventListener("click", (): void => move(1));
  timeline?.addEventListener("scroll", updateControls, { passive: true });

  timeline?.addEventListener("keydown", (event: KeyboardEvent): void => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    event.preventDefault();
    const direction = event.key === "ArrowLeft" ? -1 : 1;
    move(direction);
  });
</script>
