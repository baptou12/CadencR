---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrap from "@/components/ui/Wrap.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<BaseLayout title={`${title} — Cadencr`} description={description}>
  <section class="py-16 pb-24">
    <Wrap>
      <div class="mb-8 max-w-[680px]">
        <Eyebrow>Docs</Eyebrow>
        <h1 class="mt-3 mb-3 text-[clamp(26px,3vw,34px)] font-semibold leading-[1.18] tracking-[-0.018em] [text-wrap:balance]">
          {title}
        </h1>
      </div>
      <article class="prose">
        <slot />
      </article>
    </Wrap>
  </section>
</BaseLayout>
