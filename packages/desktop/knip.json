{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/App.tsx",
    "src/routes/**/*.tsx"
  ],
  "project": [
    "electron/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx,css}"
  ],
  "ignoreBinaries": [
    "clang",
    "oxfmt",
    "spctl"
  ],
  "ignoreDependencies": [
    "autoprefixer",
    "postcss",
    "visual-lib"
  ],
  "tags": [
    "+@public"
  ],
  "vitest": {
    "entry": [
      "src/**/*.test.{ts,tsx}",
      "src/test-utils.tsx",
      "src/test-fixtures.ts"
    ]
  }
}
