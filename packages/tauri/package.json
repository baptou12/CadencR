{
  "name": "@cadencr/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Cadencr desktop shell — Tauri app with a React frontend for driving local AI coding agents.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node ./tauri-dev.mjs",
    "build": "tauri build",
    "tauri": "tauri",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/ && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "oxfmt --check src/ && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run",
    "ts-check": "tsc --noEmit",
    "knip": "knip",
    "generate:openapi": "cargo run --quiet --manifest-path ../service/Cargo.toml --bin dump-openapi",
    "generate:api": "pnpm generate:openapi && orval --config ./orval.config.ts && oxfmt src/api/generated/"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@lexical/react": "^0.42.0",
    "@lezer/highlight": "^1.2.3",
    "@react-symbols/icons": "^1.3.1",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-query": "^4.43.0",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/router-vite-plugin": "^1.159.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "anser": "^2.3.5",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lexical": "^0.42.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.6",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "jsdom": "^28.1.0",
    "knip": "^6.3.0",
    "orval": "7.13.2",
    "oxlint": "^1.46.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
