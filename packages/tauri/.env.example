# Required for desktop/frontend dev. Copy to packages/tauri/.env and customize locally.
# VITE_FRONTEND_PORT should match packages/service/.env CADENCE_FRONTEND_PORT.
# VITE_API_TOKEN should match packages/service/.env CADENCE_AUTH_TOKEN.
# VITE_API_URL should point at the service URL, usually http://127.0.0.1:5005.

VITE_API_TOKEN=replace-with-the-same-local-token
VITE_FRONTEND_PORT=1420
VITE_API_URL=http://127.0.0.1:5005
