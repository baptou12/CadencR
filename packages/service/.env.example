# Required for service dev. Copy to packages/service/.env and customize locally.
# CADENCE_FRONTEND_PORT should match packages/tauri/.env VITE_FRONTEND_PORT.
# CADENCE_AUTH_TOKEN should match packages/tauri/.env VITE_API_TOKEN.
# CADENCE_RUST_PORT should match the port used in packages/tauri/.env VITE_API_URL.

CADENCE_AUTH_TOKEN=replace-with-a-random-local-token
CADENCE_FRONTEND_PORT=1420
CADENCE_RUST_PORT=5005
CADENCE_DB_PATH=./cadence.local.db
