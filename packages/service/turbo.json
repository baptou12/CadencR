{
  "$schema": "https://v2-9-9.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "migrations/**",
        "prompts/**",
        "Cargo.toml",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/tauri/src-tauri/binaries/cadencr-service-*"
      ]
    },
    "build:debug": {
      "inputs": [
        "src/**",
        "migrations/**",
        "prompts/**",
        "Cargo.toml",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/tauri/src-tauri/binaries/cadencr-service-*"
      ]
    }
  }
}
